<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 컨테이너 표준: stdout으로만 출력 (docker logs / CloudWatch가 수집) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 운영 -->
    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="org.dallyeo.matuabom" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        <!-- SSE timeout 시 response already committed 에러는 노이즈 — 억제 -->
        <logger name="org.apache.catalina.core.ContainerBase" level="ERROR"/>
        <logger name="org.apache.catalina.connector" level="ERROR"/>
    </springProfile>

    <!-- 로컬/개발/기본 -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="org.dallyeo.matuabom" level="DEBUG"/>
    </springProfile>

</configuration>
