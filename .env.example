# 맞춰봄 백엔드 환경변수 템플릿 — 실제 값은 .env(git 미추적)에 채운다.
# 데이터스토어는 MongoDB 단일 (Postgres/Redis 제거됨).

# ── MongoDB (유일한 데이터스토어) ──────────────────────────────────────
# 로컬: mongodb://localhost:27017/matuabom
# 운영: Atlas 연결 문자열 (mongodb+srv://<user>:<pw>@<cluster>/matuabom?retryWrites=true&w=majority)
MONGODB_URI=mongodb://localhost:27017/matuabom
MONGODB_NAME=matuabom

# ── JWT ────────────────────────────────────────────────────────────────
# openssl rand -base64 64
JWT_SECRET=

# ── OAuth (Kakao / Google) ─────────────────────────────────────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 앱 설정 ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local           # local | dev | prod
FRONTEND_ORIGIN=http://localhost:3000  # CORS 허용 오리진 (운영: https://matuabom.store)
BACKEND_BASE_URL=http://localhost:8080 # OAuth 콜백 baseUrl (운영: https://api.matuabom.store)
COOKIE_SECURE=false                    # 운영(HTTPS)에서는 true
ADMIN_SECRET=                          # 관리자 API 시크릿
ENCRYPT_KEY=                           # 토큰 암호화 키 (운영 필수)
GOOGLE_WEBHOOK_TOKEN=                  # Google Calendar Webhook 검증 토큰 (openssl rand -hex 32)
